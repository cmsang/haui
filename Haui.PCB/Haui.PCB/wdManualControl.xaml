<Window x:Class="Haui.PCB.wdManualControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Manual Control — Test Pick &amp; Place"
        Height="720" Width="1050"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        WindowStyle="None"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#2E4053"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D566E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OkBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#27AE60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#219A52"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Manual Control — Test gắp hàng" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Chọn vị trí OK hoặc NG → chạy test PickUp → đích qua SerialPort"
                       FontSize="12" Foreground="#666"/>
        </StackPanel>

        <!-- Serial -->
        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="COM" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" x:Name="CboComPort" IsEditable="True"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="Baud" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3" x:Name="CboBaudRate" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="4" x:Name="TxtSerialState" Text="● Offline"
                           Foreground="#E74C3C" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="6" x:Name="BtnSerialToggle" Content="Kết nối"
                        Style="{StaticResource PrimaryBtn}" Padding="12,6" Margin="0,0,8,0"
                        IsEnabled="{Binding CanOperateControls}"
                        Click="BtnSerialToggle_Click"/>
                <Button Grid.Column="7" Content="↻" ToolTip="Quét lại cổng COM"
                        Style="{StaticResource SecondaryBtn}" Padding="10,6"
                        IsEnabled="{Binding CanOperateControls}"
                        Click="BtnRefreshPorts_Click"/>
            </Grid>
        </Border>

        <!-- Grid OK / NG -->
        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Vị trí đích (OK / NG)" Style="{StaticResource SectionHeader}"/>
                    <Button Content="↻ Tải lại teach" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryBtn}" Padding="10,6"
                            IsEnabled="{Binding CanOperateControls}"
                            Click="BtnReloadTeach_Click"/>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="DestinationGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          IsEnabled="{Binding CanOperateControls}"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          SelectionChanged="DestinationGrid_SelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Group}" Value="OK">
                                    <Setter Property="Background" Value="#EAF7EE"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Group}" Value="NG">
                                    <Setter Property="Background" Value="#FDEDEC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" Width="72"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="72"/>
                        <DataGridTextColumn Header="J1" Binding="{Binding J1, StringFormat=F1}" Width="64"/>
                        <DataGridTextColumn Header="J2" Binding="{Binding J2, StringFormat=F1}" Width="64"/>
                        <DataGridTextColumn Header="J3" Binding="{Binding J3, StringFormat=F1}" Width="64"/>
                        <DataGridTextColumn Header="J4" Binding="{Binding J4, StringFormat=F1}" Width="64"/>
                        <DataGridTextColumn Header="J5" Binding="{Binding J5, StringFormat=F1}" Width="64"/>
                        <DataGridTextColumn Header="Gripper" Binding="{Binding GripperAngle, StringFormat=F1}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Selected summary -->
        <Border Grid.Row="3" Background="#F5F5F5" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
            <TextBlock x:Name="TxtSelectedSummary" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
        </Border>

        <!-- Actions -->
        <WrapPanel Grid.Row="4" Margin="0,12,0,0">
                        <Button x:Name="BtnRunTest" Style="{StaticResource OkBtn}" Margin="0,0,10,8"
                                IsEnabled="{Binding CanRunTest}"
                                Click="BtnRunTest_Click">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="RobotIndustrial" Width="18" Height="18"
                                 Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Chạy test (PickUp → đích)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnGoPickUp" Content="Tới PickUp" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,8"
                    IsEnabled="{Binding CanGoToPickUp}"
                    Click="BtnGoPickUp_Click"/>
            <Button x:Name="BtnGoDestination" Content="Tới vị trí đích" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,8"
                    IsEnabled="{Binding CanGoToDestination}"
                    Click="BtnGoDestination_Click"/>
        </WrapPanel>

        <!-- Status + close -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="#555"/>
            <Button Grid.Column="1" Content="Đóng" Style="{StaticResource SecondaryBtn}"
                    Padding="20,8" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
