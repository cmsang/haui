{
  "developerMode": true,
  "showInspectionResultAfterRecognition": false,
  "com": "COM20",
  "warehouseCom": "COM22",
  "baudRate": 115200,
  "stepsPerDeg": 100,
  "jogStepDegrees": 15,
  "speedPercent": 31,
  "DatabaseConnection": "Data Source=.\\SQLExpress;Initial Catalog=SmartWarehouse;Integrated Security=True;TrustServerCertificate=True",
  "ComponentDetection": {
    "modelPath": "Config/yolo26m_720x960.onnx",
    "inputWidth": 736,
    "inputHeight": 960,
    "confThreshold": 0.25,
    "iouThreshold": 0.45,
    "classNames": [
      "KF",
      "C2",
      "AMS1",
      "L23",
      "R12",
      "C365",
      "D12",
      "C1",
      "LM1",
      "L1",
      "C4"
    ],
    "defaultGroupSplit": "Horizontal",
    "componentGroups": [
      {
        "parent": "L23",
        "children": [ "L2", "L3" ]
      },
      {
        "parent": "R12",
        "children": [ "R1", "R2" ]
      },
      {
        "parent": "C365",
        "children": [ "C3", "C6", "C5" ]
      },
      {
        "parent": "D12",
        "children": [ "D1", "D2" ],
        "split": "Vertical"
      },
      {
        "parent": "KF",
        "children": [ "KF1", "KF2", "KF3" ]
      }
    ]
  },
  "PcbBoard": {
    "widthMm": 460,
    "heightMm": 590,
    "quadRectTolerancePercent": 5,
    "aspectRatioTolerancePercent": 5,
    "quadAngleToleranceDegrees": 5
  },
  "Segmentation": {
    "cannyThreshold1": 30,
    "cannyThreshold2": 120
  },
  "CameraBasler": {
    "deviceIp": "",
    "exposureTimeUs": 20000,
    "gainDb": 0,
    "gamma": 1,
    "width": 2304,
    "height": 1536,
    "pixelFormat": "Mono8",
    "gainAuto": "Continuous",
    "balanceWhiteAuto": "Continuous"
  },
  "CameraCapture": {
    "saveFolder": "../../../../captures"
  },
  "CameraDownscale": {
    "enabled": false,
    "width": 1920,
    "height": 1080
  },
  "HolderDetectionDownscale": {
    "enabled": true,
    "width": 1920,
    "height": 1080
  },
  "CameraGigEStream": {
    // GenICam GevSCPD — khoảng dừng giữa các gói UDP. Camera bench tối đa 8 FPS → tăng delay thường KHÔNG đổi FPS hiển thị.
    // Dùng để giảm mất gói rải rác. Sau offload grab thread: thử 1000 → 3000 → 5000 nếu vẫn lỗi.
    "interPacketDelay": 1000,
    // PLStream.AutoPacketSize — camera tự thương lượng kích thước gói với NIC.
    "autoPacketSize": true,
    // GevSCPSPacketSize (byte); chỉ khi autoPacketSize=false. 0 = bỏ qua. Phổ biến: 1500 hoặc 8192.
    "packetSize": 0,
    // MaxNumBuffer — số buffer ảnh pylon cấp phát (~3.5 MB × maxNumBuffer @ 2304×1536 Mono8).
    "maxNumBuffer": 24,
    // OutputQueueSize — hàng đợi LatestImages (2–3 cho live preview).
    "outputQueueSize": 2,
    "maxTransferSizeMb": 4,
    "maxBufferSizeMb": 64,
    // GrabLoopThreadPriority 25–30 khuyến nghị GigE; 0 = không ghi.
    "grabLoopThreadPriority": 25,
    // Số lỗi grab liên tiếp trước khi tự restart StreamGrabber (tối đa 1 lần/30s).
    "consecutiveFailThreshold": 15,
    "enableAutoRecovery": true
  }
}
