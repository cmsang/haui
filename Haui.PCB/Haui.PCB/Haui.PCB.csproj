<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<PlatformTarget>x64</PlatformTarget>
		<PylonRoot Condition="'$(PylonRoot)' == ''">C:\Program Files\Basler\pylon</PylonRoot>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Expression.Blend.Sdk.WPF" Version="1.0.1" />
		<PackageReference Include="MaterialDesignColors" Version="5.3.2" />
		<PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
		<PackageReference Include="MaterialDesignThemes.Wpf" Version="1.0.1" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260427" />
		<PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260427" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
		<PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260427" />
		<PackageReference Include="System.IO.Ports" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BL.PCBDetect\BL.PCBDetect.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Basler.Pylon">
			<HintPath>$(PylonRoot)\Development\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.Expression.Drawing">
			<HintPath>$(NuGetPackageRoot)\expression.blend.sdk.wpf\1.0.1\lib\net45\Microsoft.Expression.Drawing.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(PylonRoot)\Development\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll">
			<Link>Basler.Pylon.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Image\**\*.*" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Models\yolo26m_960x1280.onnx" Link="Models\yolo26m_960x1280.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Models\yolo26m_960x1280.onnx')" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Config\setting.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Config\yolo26m_720x960.onnx">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Config\yolo26m_960x1280.onnx">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>