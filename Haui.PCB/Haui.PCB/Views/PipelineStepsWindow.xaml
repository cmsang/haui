<Window x:Class="Haui.PCB.Views.PipelineStepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug Pipeline — Các bước xử lý"
        Height="700" Width="1200"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Template hiển thị một bước pipeline -->
        <DataTemplate x:Key="PipelineStepTemplate">
            <Border BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Background="#1E1E1E"
                    Margin="6" Width="260">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tên bước -->
                    <Border Grid.Row="0" Background="#333333" CornerRadius="4,4,0,0" Padding="8,4">
                        <TextBlock Text="{Binding StepName}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- Ảnh bước -->
                    <Image Grid.Row="1"
                           Source="{Binding Image}"
                           Stretch="Uniform"
                           Margin="4"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Mô tả -->
                    <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="0,0,4,4" Padding="6,4">
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11" Foreground="#AAAAAA"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Danh sách các bước — cuộn ngang ── -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Padding="4">
            <ItemsControl x:Name="StepsPanel"
                          ItemTemplate="{StaticResource PipelineStepTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Thanh trạng thái ── -->
        <Border Grid.Row="1"
                Background="#1A1A1A"
                BorderBrush="#333333"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid>
                <TextBlock x:Name="StatusText"
                           FontSize="12" Foreground="#AAAAAA"
                           VerticalAlignment="Center" />
                <ProgressBar x:Name="BusyIndicator"
                             Height="4"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             HorizontalAlignment="Right"
                             Width="150"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
