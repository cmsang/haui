<Window x:Class="Haui.PCB.Views.CreateTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo mẫu nhận diện"
        Height="650" Width="1000"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D8D8D8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#D13438"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A4262C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== CONTENT ===== -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- ── Ảnh bo mạch + canvas kéo thả ── -->
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    Margin="0,0,6,0">
                <Grid>
                    <Image x:Name="BoardImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality"/>
                    <TextBlock x:Name="BoardPlaceholder"
                               Text="Đang tải ảnh bo mạch..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888888"
                               FontSize="14"/>
                    <!-- Canvas kéo thả + vẽ các vùng đã chọn -->
                    <Canvas x:Name="RegionCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="RegionCanvas_MouseLeftButtonDown"
                            MouseMove="RegionCanvas_MouseMove"
                            MouseLeftButtonUp="RegionCanvas_MouseLeftButtonUp">
                        <!-- Hình chữ nhật đang kéo thả -->
                        <Rectangle x:Name="DragRect"
                                   Stroke="Yellow"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 2"
                                   Fill="#330078D4"
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- ── Panel danh sách vùng ── -->
            <Border Grid.Column="1"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Danh sách vùng"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding RegionProgressText}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="RegionsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              FontSize="12"
                              SelectionChanged="RegionsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <!-- Cột STT -->
                            <DataGridTextColumn Header="STT"
                                               Binding="{Binding Stt}"
                                               Width="36"
                                               IsReadOnly="True"/>
                            <!-- Cột màu: ô vuông màu tương ứng với màu vùng trên canvas -->
                            <DataGridTemplateColumn Header="" Width="24" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="14" Height="14"
                                                CornerRadius="2"
                                                Background="{Binding RegionBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tên vùng"
                                               Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                               Width="*"
                                               IsReadOnly="False"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Style="{StaticResource DangerBtn}"
                                                Click="BtnDeleteRegion_Click"
                                                Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Thư mục lưu dữ liệu"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>
                        <CheckBox Content="Dùng thư mục tùy chỉnh"
                                  IsChecked="{Binding UseCustomDataFolder, Mode=TwoWay}"
                                  FontSize="12"
                                  Margin="0,0,0,6"/>
                        <TextBox Text="{Binding DataFolder, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,6"/>
                        <Button Content="Chọn thư mục..."
                                Height="28"
                                FontSize="12"
                                Click="BtnBrowseDataFolder_Click"/>
                        <TextBlock Text="Mặc định: templates/ cạnh app. Khi bật tùy chỉnh, lưu thư viện và mẫu Test vào thư mục đã chọn."
                                   TextWrapping="Wrap"
                                   Foreground="#666666"
                                   FontSize="10"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BOTTOM BAR ===== -->
        <Border Grid.Row="1"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12"
                           Text="Sẵn sàng."/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnSave"
                            Content="💾 Lưu"
                            Height="32" Width="90"
                            Margin="0,0,8,0"
                            Click="BtnSave_Click"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource PrimaryBtn}"/>
                    <Button x:Name="BtnRotate180"
                            Content="↻ Xoay 180°"
                            Height="32" Width="110"
                            Margin="0,0,8,0"
                            Click="BtnRotate180_Click"
                            IsEnabled="{Binding CanRotateBoard}"
                            Style="{StaticResource SecondaryBtn}"/>
                    <Button Content="✕ Đóng"
                            Height="32" Width="80"
                            Click="BtnClose_Click"
                            Style="{StaticResource DangerBtn}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
