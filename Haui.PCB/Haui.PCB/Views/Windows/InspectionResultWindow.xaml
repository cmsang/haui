<Window x:Class="Haui.PCB.Views.Windows.InspectionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kết quả nhận diện"
        Height="720" Width="1050"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F0F4FA"
                BorderBrush="#B0C4DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="13" Foreground="#1A3A6B" Margin="0,0,0,4">
                        <Run Text="Chế độ: "/>
                        <Run Text="{Binding InspectionModeLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#333333"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Border BorderBrush="#CFCFCF"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="#FAFAFA"
                            Padding="10,4"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding TotalInspectionElapsedText}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#666666"/>
                    </Border>
                    <Border x:Name="PassFailPanel"
                            BorderBrush="#CFCFCF"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="#FAFAFA"
                            Padding="16,4">
                        <TextBlock x:Name="PassFailText"
                                   Text="{Binding PassFailLabel, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <TextBlock x:Name="ImagePlaceholder"
                               Text="Không có ảnh kết quả"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888888"
                               FontSize="14"/>
                    <Image x:Name="ResultImage"
                           Stretch="Uniform"
                           Margin="8"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#C0CCE0"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#F0F4FA"
                            BorderBrush="#C0CCE0"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <TextBlock Text="Danh sách kết quả"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#1A3A6B"/>
                    </Border>
                    <TextBlock Grid.Row="1"
                               Margin="10,8,10,4"
                               Text="{Binding WhiteCircuitSummaryText}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#333333"
                               Visibility="{Binding HasWhiteCircuitSummary, Converter={StaticResource BoolToVis}}"/>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding InspectionResults}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              FontSize="12"
                              Margin="4"
                              MinRowHeight="28"
                              Visibility="{Binding HasInspectionResultList, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT"
                                                Binding="{Binding Stt}"
                                                Width="48"/>
                            <DataGridTextColumn Header="Tên"
                                                Binding="{Binding Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Độ tương đồng"
                                                Binding="{Binding SimilarityDisplayText}"
                                                Width="96"/>
                            <DataGridTextColumn Header="Kết quả"
                                                Binding="{Binding ResultText}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Ghi chú"
                                                Binding="{Binding StatusNote}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               Text="Không có dữ liệu chi tiết."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888888"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInspectionResultList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Đóng"
                    Width="90"
                    Height="32"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
