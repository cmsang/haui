<Window x:Class="Haui.PCB.Views.Windows.TemplateViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Haui.PCB.Views.Controls"
        Title="Thư viện ảnh mẫu"
        Height="680" Width="1100"
        MinHeight="480" MinWidth="750"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Closed="Window_Closed"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F4FA"/>
            <Setter Property="BorderBrush" Value="#C0CCE0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A3A6B"/>
        </Style>

        <Style x:Key="DataGridCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="DataGridNumericCellTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DataGridCellTextStyle}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="DataGridSttCellTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DataGridCellTextStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="NaN"/>
            <Setter Property="MinRowHeight" Value="30"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== CONTENT ===== -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: 2 grid -->
                <ColumnDefinition Width="420" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── Cột trái ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Grid 1: Danh sách ảnh mẫu -->
                <Border Grid.Row="0"
                        BorderBrush="#C0CCE0" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" CornerRadius="4,4,0,0">
                            <TextBlock Text="📋 Danh sách ảnh mẫu"
                                       Style="{StaticResource SectionTitleStyle}"/>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  x:Name="TemplatesGrid"
                                  Style="{StaticResource DataGridStyle}"
                                  LoadingRow="DataGrid_LoadingRow"
                                  SelectionChanged="TemplatesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT"
                                                   Binding="{Binding Stt}"
                                                   Width="56"
                                                   MinWidth="56"
                                                   ElementStyle="{StaticResource DataGridSttCellTextStyle}"/>
                                <DataGridTextColumn Header="Tên mẫu"
                                                   Binding="{Binding Name}"
                                                   Width="2*"
                                                   MinWidth="100"
                                                   ElementStyle="{StaticResource DataGridCellTextStyle}"/>
                                <DataGridTextColumn Header="Số vùng"
                                                   Binding="{Binding RegionCount}"
                                                   Width="76"
                                                   ElementStyle="{StaticResource DataGridSttCellTextStyle}"/>
                                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:DeleteIconButton
                                                Click="BtnDeleteTemplateRow_Click"
                                                Tag="{Binding}"
                                                ToolTip="Xóa mẫu"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Grid 2: Danh sách vùng của mẫu đang chọn -->
                <Border Grid.Row="2"
                        BorderBrush="#C0CCE0" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" CornerRadius="4,4,0,0">
                            <TextBlock Text="🔲 Các vùng được chọn"
                                       Style="{StaticResource SectionTitleStyle}"/>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  x:Name="RegionsGrid"
                                  Style="{StaticResource DataGridStyle}"
                                  LoadingRow="DataGrid_LoadingRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT"
                                                   Binding="{Binding Stt}"
                                                   Width="56"
                                                   MinWidth="56"
                                                   ElementStyle="{StaticResource DataGridSttCellTextStyle}"/>
                                <!-- Ô màu tương ứng với màu vùng trên ảnh mẫu -->
                                <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="14" Height="14"
                                                    CornerRadius="2"
                                                    Background="{Binding RegionBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tên vùng"
                                                   Binding="{Binding Name}"
                                                   Width="2*"
                                                   MinWidth="72"
                                                   ElementStyle="{StaticResource DataGridCellTextStyle}"/>
                                <DataGridTextColumn Header="Vị trí"
                                                   Binding="{Binding Position}"
                                                   Width="1.2*"
                                                   MinWidth="96"
                                                   ElementStyle="{StaticResource DataGridNumericCellTextStyle}"/>
                                <DataGridTextColumn Header="Kích thước"
                                                   Binding="{Binding Size}"
                                                   Width="1.2*"
                                                   MinWidth="96"
                                                   ElementStyle="{StaticResource DataGridNumericCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- ── Cột phải: Xem ảnh mẫu ── -->
            <Border Grid.Column="2"
                    Background="#1E1E1E"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#2A2A2A"
                            CornerRadius="4,4,0,0"
                            Padding="8,5">
                        <TextBlock Text="🖼 Xem ảnh mẫu"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#DDDDDD"/>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="PreviewPlaceholder"
                                   Text="Chọn một ảnh mẫu để xem"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#666666"
                                   FontSize="14"/>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Canvas vẽ các vùng đã chọn lên ảnh mẫu -->
                        <Canvas x:Name="RegionOverlayCanvas"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Margin="8"
                                SizeChanged="RegionOverlayCanvas_SizeChanged"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BOTTOM BAR ===== -->
        <Border Grid.Row="1"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12"
                           Text="Sẵn sàng."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnEditTemplate"
                            Content="✏ Sửa"
                            Height="30" Width="80"
                            Margin="0,0,8,0"
                            Click="BtnEditTemplate_Click"/>
                    <Button Content="✕ Đóng"
                            Height="30" Width="80"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
