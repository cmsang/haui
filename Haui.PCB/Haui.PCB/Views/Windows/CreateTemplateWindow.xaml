<Window x:Class="Haui.PCB.Views.Windows.CreateTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Haui.PCB.Views.Controls"
        Title="Tạo mẫu nhận diện"
        Height="650" Width="1000"
        MinHeight="480" MinWidth="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Closed="Window_Closed"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#D13438"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A4262C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#E8EEF5"
                BorderBrush="#B0C4DE"
                BorderThickness="0,0,0,1"
                Padding="10,8"
                Margin="8,8,8,0">
            <TextBlock Text="{Binding ModeBannerText}"
                       FontSize="13"
                       Foreground="#1A3A6B"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ===== CONTENT ===== -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- ── Ảnh bo mạch + canvas kéo thả (zoom / cuộn) ── -->
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    Margin="0,0,6,0">
                <Grid>
                    <ScrollViewer x:Name="BoardScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  PreviewMouseWheel="BoardScrollViewer_PreviewMouseWheel">
                        <Grid x:Name="BoardViewHost"
                              Background="Transparent"
                              MouseLeftButtonDown="BoardViewHost_MouseLeftButtonDown"
                              MouseMove="BoardViewHost_MouseMove"
                              MouseLeftButtonUp="BoardViewHost_MouseLeftButtonUp"
                              LostMouseCapture="BoardViewHost_LostMouseCapture">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="BoardZoomTransform"
                                                ScaleX="1"
                                                ScaleY="1"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="BoardImage"
                                   Stretch="Fill"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <!-- Canvas kéo thả + vẽ các vùng đã chọn -->
                            <Canvas x:Name="RegionCanvas"
                                    Background="Transparent"
                                    IsHitTestVisible="False">
                                <!-- Hình chữ nhật đang kéo thả -->
                                <Rectangle x:Name="DragRect"
                                           Stroke="Yellow"
                                           StrokeThickness="2"
                                           StrokeDashArray="4 2"
                                           Fill="#330078D4"
                                           Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="BoardPlaceholder"
                               Text="Đang tải ảnh bo mạch..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888888"
                               FontSize="14"
                               IsHitTestVisible="False"/>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8"
                            Background="#CC1E1E1E"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,4"
                            IsHitTestVisible="True">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnZoomOut"
                                    Content="−"
                                    Width="28" Height="28"
                                    FontSize="16"
                                    ToolTip="Thu nhỏ (Ctrl + cuộn chuột)"
                                    Click="BtnZoomOut_Click"
                                    Style="{StaticResource SecondaryBtn}"/>
                            <TextBlock x:Name="ZoomLevelText"
                                       Text="100%"
                                       Width="44"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#EEEEEE"
                                       FontSize="12"
                                       Margin="4,0"/>
                            <Button x:Name="BtnZoomIn"
                                    Content="+"
                                    Width="28" Height="28"
                                    FontSize="16"
                                    ToolTip="Phóng to (Ctrl + cuộn chuột)"
                                    Click="BtnZoomIn_Click"
                                    Style="{StaticResource SecondaryBtn}"/>
                            <Button x:Name="BtnZoomFit"
                                    Content="Vừa khung"
                                    Height="28"
                                    Margin="6,0,0,0"
                                    ToolTip="Đặt lại mức phóng to vừa khung"
                                    Click="BtnZoomFit_Click"
                                    Style="{StaticResource SecondaryBtn}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Panel danh sách vùng ── -->
            <Border Grid.Column="1"
                    Background="#FAFAFA"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Danh sách vùng"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegionProgressText}"
                                   FontSize="12"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <CheckBox Content="Đặt vị trí thành phần xác định chiều"
                                  IsChecked="{Binding IsSettingOrientationPosition}"
                                  IsEnabled="{Binding CanSetOrientationPosition}"
                                  Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding OrientationPositionHint}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="22,2,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="STT"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Tên vùng"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,0"/>
                    </Grid>

                    <ListBox Grid.Row="2"
                             x:Name="RegionsGrid"
                             ItemContainerStyle="{StaticResource StretchListBoxItemStyle}"
                             SelectionChanged="RegionsGrid_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Stt}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="12"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.AllowedRegionNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                              Foreground="{Binding NameForeground}"
                                              IsEditable="False"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0"
                                              Padding="2,0"/>
                                    <controls:DeleteIconButton Grid.Column="2"
                                                               Click="BtnDeleteRegion_Click"
                                                               Tag="{Binding}"
                                                               ToolTip="Xóa vùng"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BOTTOM BAR ===== -->
        <Border Grid.Row="2"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12"
                           Text="Sẵn sàng."/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnRotate180"
                            Content="↻ Xoay 180°"
                            Height="32" Width="110"
                            Click="BtnRotate180_Click"
                            IsEnabled="{Binding CanRotateBoard}"
                            Style="{StaticResource SecondaryBtn}"/>
                    <Button x:Name="BtnSave"
                            Content="💾 Lưu"
                            Height="32" Width="90"
                            Margin="8,0,8,0"
                            Click="BtnSave_Click"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource PrimaryBtn}"/>
                    <Button Content="✕ Đóng"
                            Height="32" Width="80"
                            Click="BtnClose_Click"
                            Style="{StaticResource DangerBtn}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
