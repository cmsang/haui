<Window x:Class="Haui.PCB.Views.Windows.CannyThresholdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canny Threshold"
        Height="720" Width="1100"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#333333"
                            CornerRadius="4,4,0,0"
                            Padding="8,4">
                        <TextBlock Text="Ảnh gốc (đã chụp)"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                    </Border>
                    <Image x:Name="SourceImage"
                           Grid.Row="1"
                           Stretch="Uniform"
                           Margin="8"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#1E1E1E"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="#333333"
                                CornerRadius="4,4,0,0"
                                Padding="8,4">
                            <TextBlock Text="Cạnh Canny"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                        </Border>
                        <Image x:Name="CannyImage"
                               Grid.Row="1"
                               Stretch="Uniform"
                               Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#1E1E1E"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="#333333"
                                CornerRadius="4,4,0,0"
                                Padding="8,4">
                            <TextBlock Text="Morphology Close"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                        </Border>
                        <Image x:Name="MorphImage"
                               Grid.Row="1"
                               Stretch="Uniform"
                               Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="#F0F4FA"
                BorderBrush="#B0C4DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Canny threshold 1"
                               VerticalAlignment="Center"
                               Foreground="#333333"/>
                    <Slider x:Name="SliderT1"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="300"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            Margin="8,0"
                            ValueChanged="Threshold_ValueChanged"/>
                    <TextBox x:Name="TextT1"
                             Grid.Column="2"
                             Height="28"
                             VerticalContentAlignment="Center"
                             FontFamily="Consolas"
                             TextChanged="TextT1_TextChanged"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Canny threshold 2"
                               VerticalAlignment="Center"
                               Foreground="#333333"/>
                    <Slider x:Name="SliderT2"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="500"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            Margin="8,0"
                            ValueChanged="Threshold_ValueChanged"/>
                    <TextBox x:Name="TextT2"
                             Grid.Column="2"
                             Height="28"
                             VerticalContentAlignment="Center"
                             FontFamily="Consolas"
                             TextChanged="TextT2_TextChanged"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#555555"
                       FontSize="12"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="Lưu"
                        Width="90"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="BtnSave_Click"/>
                <Button Content="Đóng"
                        Width="90"
                        Height="32"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
