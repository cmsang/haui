<UserControl x:Class="Haui.PCB.Views.Tabs.JobHistoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <md:PackIcon Kind="History" Width="64" Height="64" Foreground="#90A4AE"
                         HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Job History" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Lịch sử lệnh và chu trình sẽ hiển thị tại đây."
                       FontSize="14" Foreground="#666666" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
