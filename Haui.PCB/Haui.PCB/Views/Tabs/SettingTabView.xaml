<UserControl x:Class="Haui.PCB.Views.Tabs.SettingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Haui.PCB.Views.Controls"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Foreground" Value="#444444"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Cài đặt hệ thống" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="13"
                       Text="Chỉnh sửa và lưu trực tiếp vào Config/setting.json. Một số thay đổi cần khởi động lại hoặc làm mới tab liên quan."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0">

                <!-- Developer -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Chế độ phát triển" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Bật DeveloperMode (hiện nút tạo mẫu trên Dashboard)"
                                  IsChecked="{Binding DeveloperMode, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="11" Margin="0,4,0,0"
                                   Text="Mặc định tắt trên máy vận hành. Bật để tạo/sửa mẫu linh kiện."/>
                    </StackPanel>
                </Border>

                <!-- Inspection -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Kiểm tra (Dashboard)" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Hiện cửa sổ kết quả nhận diện sau khi kiểm tra xong"
                                  IsChecked="{Binding ShowInspectionResultAfterRecognition, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="11"
                                   Text="Mặc định tắt — kết quả vẫn hiển thị trên Dashboard. Bật để mở popup chi tiết trước khi robot phân loại."/>
                    </StackPanel>
                </Border>

                <!-- Robot -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Robot" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Cổng COM robot" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding Com, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Text="Cổng COM warehouse" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding WarehouseCom, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Text="Baud rate" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="Steps / độ" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding StepsPerDeg, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Text="Bước jog (độ)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding JogStepDegrees, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Text="Tốc độ Go To (%)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding SpeedPercent, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Database -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Cơ sở dữ liệu" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="DatabaseConnection" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource FieldTextBox}" MinHeight="56" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding DatabaseConnection, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="2">

                <!-- Component templates -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Thư viện mẫu linh kiện / mạch trắng" Style="{StaticResource SectionTitle}"/>

                        <CheckBox Content="Train mạch trắng"
                                  IsChecked="{Binding TrainWhiteCircuit, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Thư mục mẫu linh kiện" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     IsEnabled="{Binding IsComponentRegionNamesVisible}"
                                     Text="{Binding TemplateCustomFolder, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="Thư mục mẫu mạch trắng" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     IsEnabled="{Binding TrainWhiteCircuit}"
                                     Text="{Binding WhiteCircuitCustomFolder, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Text="Ngưỡng giống (%)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding MinMatchSimilarityPercent, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Text="Thành phần xác định chiều"
                                       Style="{StaticResource FieldLabel}"
                                       ToolTip="Tên vùng dùng để xác định chiều mạch khi kiểm tra"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding OrientationComponentName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="4" Text="Xác suất tối thiểu chiều"
                                       Style="{StaticResource FieldLabel}"
                                       ToolTip="Ngưỡng CCoeffNormed (0–1) khi so khớp chiều mạch"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding MinOrientationMatchScore, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <StackPanel Visibility="{Binding IsComponentRegionNamesVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Danh sách tên vùng được phép (AllowedRegionNames)"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,4,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="11" Margin="0,0,0,8"
                                   Text="Thứ tự trong bảng quyết định STT và số vùng bắt buộc khi tạo mẫu linh kiện."/>

                        <DataGrid x:Name="AllowedRegionNamesGrid"
                                  ItemsSource="{Binding AllowedRegionNames}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  FontSize="12"
                                  MinHeight="120"
                                  MaxHeight="280"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT"
                                                    Binding="{Binding Index}"
                                                    Width="48"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tên vùng"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>
                                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="44">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,4,0"/>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:DeleteIconButton Click="BtnDeleteRegionName_Click"
                                                                       Tag="{Binding}"
                                                                       ToolTip="Xóa dòng"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Thêm dòng" Height="32" Width="110" HorizontalAlignment="Left"
                                Click="BtnAddRegionName_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Holder support frame -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Hộp đỡ PCB (PcbBoard)" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Chiều rộng hộp đỡ (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding PcbBoardWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="Chiều cao hộp đỡ (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding PcbBoardHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Text="Sai số hình chữ nhật (%)"
                                       Style="{StaticResource FieldLabel}"
                                       ToolTip="Sai số tối đa giữa hai cạnh đối của khung hộp đỡ"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding HolderQuadRectTolerancePercent, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Text="Sai số tỷ lệ hộp đỡ (%)"
                                       Style="{StaticResource FieldLabel}"
                                       ToolTip="Sai số tỷ lệ rộng/cao so với kích thước hộp đỡ (mm)"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding HolderAspectRatioTolerancePercent, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="4" Text="Sai số góc (°)"
                                       Style="{StaticResource FieldLabel}"
                                       ToolTip="Sai số tối đa so với góc vuông 90° tại mỗi góc khung hộp đỡ"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding HolderQuadAngleToleranceDegrees, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Camera capture -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Lưu ảnh chụp nhanh" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thư mục lưu" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding CameraCaptureSaveFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding SaveStatusText}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="#666666" FontSize="12"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đặt lại" Height="36" Width="120" Margin="0,0,8,0"
                        Click="BtnResetSettings_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                <Button Content="Lưu cài đặt" Height="36" Width="140"
                        Click="BtnSaveSettings_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
