<UserControl x:Class="Haui.PCB.Views.Tabs.DashboardTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource MaterialDesignFont}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="UserControl_Loaded"
             IsVisibleChanged="UserControl_IsVisibleChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="8,6,8,0" />
        </Style>
        <DataTemplate x:Key="PipelineStepTemplate">
            <Border BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Background="#1E1E1E"
                    Margin="4" Width="200"
                    ToolTip="{Binding Description}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="140" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#333333" CornerRadius="4,4,0,0" Padding="6,3">
                        <TextBlock Text="{Binding StepName}"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Image Grid.Row="1"
                           Source="{Binding Image}"
                           Stretch="Uniform"
                           Margin="4"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="0,0,4,4" Padding="4,3">
                        <TextBlock Text="{Binding ElapsedText}"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="#88CC88"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Grid_Camera" Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="248" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Camera:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                    <ComboBox x:Name="CameraComboBox"
                              Width="150" Height="30"
                              FontSize="13"
                              SelectionChanged="CameraComboBox_SelectionChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Độ phân giải:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                    <ComboBox x:Name="ResolutionComboBox"
                              Width="120" Height="30"
                              FontSize="13" />
                </StackPanel>
                <Separator Width="1" Height="28" Background="#CCCCCC" Margin="4,0,12,0" />
                <Button x:Name="BtnStart"
                        Content="▶ Bắt đầu"
                        Height="30" Width="100"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnStart_Click"/>
                <Button x:Name="BtnStop"
                        Content="■ Dừng"
                        Height="30" Width="100"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnStop_Click"/>
                <Button x:Name="BtnTest"
                        Content="🔬 Test"
                        Height="30" Width="100"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnTest_Click"/>
                <Button x:Name="BtnSelectImage"
                        Content="📂 Chọn ảnh"
                        Height="30" Width="120"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnSelectImage_Click" />
                <Button x:Name="BtnSelectRegion"
                        Content="🔲 Chọn vùng"
                        Height="30" Width="120"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="BtnSelectRegion_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="BtnCreateTemplate"
                        Content="📋 Tạo mẫu"
                        Height="30" Width="110"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Margin="0,0,8,0"
                        Click="BtnCreateTemplate_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="BtnCreateFiducialTemplates"
                        Content="⭕ Thêm mẫu lỗ"
                        Height="30" Width="130"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Margin="0,0,8,0"
                        Click="BtnCreateFiducialTemplates_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="BtnSelectFiducialImage"
                        Content="📂 Chọn ảnh lỗ"
                        Height="30" Width="130"
                        Visibility="Collapsed"
                        Margin="0,0,8,0"
                        Click="BtnSelectFiducialImage_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="BtnViewTemplates"
                        Content="🖼 Xem mẫu"
                        Height="30" Width="110"
                        Margin="0,0,8,0"
                        Click="BtnViewTemplates_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="BtnCapture"
                        Content="📷 Chụp"
                        Height="30" Width="90"
                        IsEnabled="False"
                        Click="BtnCapture_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </WrapPanel>
        </Border>

        <!-- Main: camera | result + pass/fail -->
        <Grid Grid.Row="1" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Original camera feed -->
            <Border Grid.Column="0"
                    BorderBrush="#B8D4B8"
                    BorderThickness="1"
                    Background="#E8F5E9"
                    CornerRadius="4">
                <Grid>
                    <TextBlock Text="Hình ảnh từ camera (ảnh gốc)"
                               Style="{StaticResource PanelHeaderStyle}" />
                    <Border Margin="8,28,8,8"
                            Background="#1E1E1E"
                            CornerRadius="2">
                        <Grid>
                            <Image x:Name="CameraImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="LowQuality" />
                            <TextBlock x:Name="CameraPlaceholder"
                                       Text="Camera chưa khởi động"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#888888"
                                       FontSize="14" />
                            <Canvas x:Name="SelectionCanvas"
                                    Background="Transparent"
                                    MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                                    MouseMove="SelectionCanvas_MouseMove"
                                    MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp"
                                    IsHitTestVisible="False">
                                <Rectangle x:Name="DragRect"
                                           Stroke="Yellow"
                                           StrokeThickness="2"
                                           StrokeDashArray="4 2"
                                           Fill="Transparent"
                                           Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Recognition result image -->
                <Border Grid.Row="0"
                        BorderBrush="#E6D48A"
                        BorderThickness="1"
                        Background="#FFF9E6"
                        CornerRadius="4">
                    <Grid>
                        <TextBlock Text="Hình ảnh kết quả nhận dạng"
                                   Style="{StaticResource PanelHeaderStyle}" />
                        <Border Margin="8,28,8,8"
                                Background="#1E1E1E"
                                CornerRadius="2">
                            <Grid>
                                <Image x:Name="ResultImage"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="ResultPlaceholder"
                                           Text="Chưa kiểm tra"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#666666"
                                           FontSize="13" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Result summary panel -->
                <Border x:Name="ComponentResultsPanel"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        MinHeight="180"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Background="#F7F7F7"
                        CornerRadius="4">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Kết quả:"
                                       FontSize="14"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"
                                       Margin="2,2,6,2" />
                            <TextBlock Grid.Column="1"
                                       FontSize="14"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Margin="0,2,8,2">
                                <Run Text="{Binding MatchedComponentCount, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding SearchedComponentCount, Mode=OneWay}" />
                            </TextBlock>
                            <Border x:Name="PassFailPanel"
                                    Grid.Column="2"
                                    BorderBrush="#CFCFCF"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Background="#FAFAFA"
                                    Padding="12,2"
                                    Margin="0,1,0,1">
                                <TextBlock x:Name="PassFailText"
                                           Text="—"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#888888" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="0"
                                VerticalAlignment="Bottom"
                                BorderBrush="#DCDCDC"
                                BorderThickness="0,0,0,1" />

                        <Grid Grid.Row="1" Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="D/s linh kiện thiếu:"
                                       FontSize="14"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"
                                       Margin="2,2,6,2" />
                            <TextBlock Grid.Column="1"
                                       FontSize="14"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Margin="0,2,2,2">
                                <Run Text="{Binding MissingComponentCount, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding SearchedComponentCount, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="1"
                                VerticalAlignment="Bottom"
                                BorderBrush="#DCDCDC"
                                BorderThickness="0,0,0,1" />

                        <Grid Grid.Row="3" Margin="0,0,0,2">
                            <DataGrid ItemsSource="{Binding DifferentRegions}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeight="28"
                                      MaxHeight="116"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True"
                                      FontSize="12"
                                      Visibility="{Binding HasComponentResults, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT"
                                                        Binding="{Binding Stt}"
                                                        Width="52" />
                                    <DataGridTextColumn Header="Tên linh kiện"
                                                        Binding="{Binding Name}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Độ tương đồng"
                                                        Binding="{Binding SimilarityDisplayText}"
                                                        Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Chưa kiểm tra"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#888888"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasComponentResults}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Processing steps gallery -->
        <Border Grid.Row="2"
                Margin="8,4,8,8"
                BorderBrush="#A8C8A8"
                BorderThickness="1"
                Background="#E0F0E0"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Ảnh các bước xử lý"
                           Style="{StaticResource PanelHeaderStyle}" />
                <ScrollViewer Grid.Row="1"
                              Margin="4,0,4,6"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PipelineStepsPanel"
                                  ItemTemplate="{StaticResource PipelineStepTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="PipelineStepsPlaceholder"
                           Grid.Row="1"
                           Text="Chưa có bước xử lý — bấm Test để kiểm tra"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           FontSize="12" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Sẵn sàng."
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12" />
                <TextBlock x:Name="FpsText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
