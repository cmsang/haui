<UserControl x:Class="Haui.PCB.Views.Tabs.DashboardTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Haui.PCB.Views.Controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Loaded="UserControl_Loaded"
             IsVisibleChanged="UserControl_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="0*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1">
                            <controls:ArcGauge x:Name="AGV_Connect"
                            AngleValue="0"
                            TotalValue= "1"
                            FullValue="1"                                    
                            EmptyValue="0"
                            ColorArc1Value="#90a4ae"
                            ColorArc2Value="#8d6e63"
                            ColorText1Value="DarkBlue"
                            ColorText2Value="#90a4ae"
                            Text1Value="C" 
                            Text2Value="D" 
                            VerticalAlignment="Bottom" 
                            Height="127" Margin="0,-3,0,-15"/>
                        </Grid>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <!--<Rectangle  Height="80" Width="1" Fill="Gray" HorizontalAlignment="Left" Margin="0,20"/>-->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Label x:Name="lbl_LoadCount" Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="40" FontWeight="Bold"/>
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="1">
                                <Rectangle Width="1" Fill="Gray" HorizontalAlignment="Right"/>
                                <Label x:Name="lbl_UnloadCount" Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="40" FontWeight="Bold"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="0">
                                <Label Content="LOAD" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="1">
                                <Rectangle Width="1" Fill="Gray" HorizontalAlignment="Right"/>
                                <Label Content="UNLOAD" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                            </Grid>

                        </Grid>
                        <Grid Grid.Column="2">
                            <controls:ArcGauge x:Name="AGV_FullState"
                            AngleValue="{Binding Angle_Empty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TotalValue="{Binding TotalAGV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FullValue="{Binding Full_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EmptyValue="{Binding Empty_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ColorArc1Value="#90a4ae"
                            ColorArc2Value="#8d6e63"
                            ColorText1Value="DarkBlue"
                            ColorText2Value="#90a4ae"                                  
                            Text1Value="F" 
                            Text2Value="E" 
                            VerticalAlignment="Bottom" 
                            Height="127"
                            TitleValue="CONNECT" Margin="0,-3,0,-15"/>

                        </Grid>
                        <Grid Grid.Column="3">
                            <controls:ArcGauge x:Name="AGV_RunState"
                            AngleValue="{Binding AngleDisconnect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TotalValue="{Binding TotalAGV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FullValue="{Binding Run_value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EmptyValue="{Binding Stop_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ColorArc1Value="#90a4ae"
                            ColorArc2Value="#8d6e63"
                            ColorText1Value="DarkBlue"
                            ColorText2Value="#90a4ae"
                            Text1Value="R" 
                            Text2Value="S" 
                            VerticalAlignment="Bottom" 
                            Height="127"
                            TitleValue="CONNECT" Margin="0,-3,0,-15"/>

                        </Grid>
                        <Grid Grid.Column="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="0.1*"/>
                                <RowDefinition Height="1*"/>
                                <!--<RowDefinition Height="0.1*"/>-->
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0"  Background="#FFE0EAEA">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="1.5*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Content="5 MIN" 
                                   HorizontalAlignment="Center" VerticalContentAlignment="Center" 
                                   FontSize="9" Width="32" />
                                </Grid>

                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="2"  Background="#FFE0EAEA">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="1.5*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Content="10 MIN" 
                                   HorizontalAlignment="Center" VerticalContentAlignment="Center" 
                                   FontSize="9" Width="38"/>
                                </Grid>

                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="0"  Background="#FFE0EAEA">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="1.5*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Content="15 MIN" 
                                   HorizontalAlignment="Center" VerticalContentAlignment="Center" 
                                   FontSize="9" Width="38"/>
                                </Grid>

                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="2"  Background="#FFE0EAEA">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="1.5*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Content="20 MIN" 
                                   HorizontalAlignment="Center" VerticalContentAlignment="Center" 
                                   FontSize="9" Width="38"/>
                                </Grid>

                            </Grid>

                        </Grid>
                        <Grid Grid.Column="5">
                            <Rectangle Width="1" Fill="Gray" HorizontalAlignment="Left"/>
                            <controls:ArcGauge x:Name="Buffer_FullState"
                            AngleValue="{Binding AngleDisconnect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TotalValue="{Binding TotalAGV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FullValue="{Binding Full_value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EmptyValue="{Binding Empty_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ColorArc1Value="#90a4ae"
                            ColorArc2Value="#8d6e63"
                            ColorText1Value="DarkBlue"
                            ColorText2Value="#90a4ae"
                            Text1Value="F" 
                            Text2Value="E" 
                            VerticalAlignment="Bottom" 
                            Height="127"
                            TitleValue="CONNECT" HorizontalAlignment="Left" Margin="0,-3,0,-15" Width="219" />

                        </Grid>
                        <!--<Grid Grid.Column="6">
                    <controls:ArcGauge Width="222" 
                        AngleValue="{Binding AngleDisconnect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TotalValue="{Binding TotalAGV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FullValue="{Binding Full_value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        EmptyValue="{Binding Empty_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ColorArc1Value="#90a4ae"
                        ColorArc2Value="#8d6e63"
                        ColorText1Value="DarkBlue"
                        ColorText2Value="#90a4ae"
                        Text1Value="F" 
                        Text2Value="E" 
                        VerticalAlignment="Bottom" 
                        Height="127"
                        TitleValue="CONNECT" Margin="1,0,-53,-20" />

                </Grid>-->
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <!--<Grid Grid.Column="0">
                <Label Content="System" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
            </Grid>-->
                        <Grid Grid.Column="1">
                            <Label Content="COMMAND" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Label Content="VEHICLE" 
                           HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Grid.Column="3">
                            <Label Content="BUFFER" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <!--<Grid Grid.Column="4">
                    <Label Content="FULL STATE" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                </Grid>-->
                        <!--<Grid Grid.Column="5">
                    <Label Content="FULL STATE" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <Grid Grid.Column="7">
                    <Label Content="FULL STATE" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                </Grid>-->
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid x:Name="Grid_Camera" Background="AliceBlue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ===== TOOLBAR ===== -->
                    <Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="10,6">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Chọn camera -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Camera:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                                <ComboBox x:Name="CameraComboBox"
                              Width="150" Height="30"
                              FontSize="13"
                              SelectionChanged="CameraComboBox_SelectionChanged" />
                            </StackPanel>

                            <!-- Chọn độ phân giải -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Độ phân giải:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                                <ComboBox x:Name="ResolutionComboBox"
                              Width="120" Height="30"
                              FontSize="13" />
                            </StackPanel>

                            <Separator Width="1" Height="28" Background="#CCCCCC" Margin="4,0,12,0" />

                            <!-- Nút Start -->
                            <Button x:Name="BtnStart"
                            Content="▶ Bắt đầu"
                            Height="30" Width="100"
                            Margin="0,0,8,0"
                            Click="BtnStart_Click"/>

                            <!-- Nút Stop -->
                            <Button x:Name="BtnStop"
                            Content="■ Dừng"
                            Height="30" Width="100"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnStop_Click"/>

                            <!-- Nút Test -->
                            <Button x:Name="BtnTest"
                            Content="🔬 Test"
                            Height="30" Width="100"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnTest_Click"/>

                            <!-- Nút Test 2: xem từng bước pipeline -->
                            <Button x:Name="BtnTest2"
                            Content="🧪 Test 2"
                            Height="30" Width="100"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnTest2_Click"/>

                            <!-- Nút chọn vùng nhận diện -->
                            <Button x:Name="BtnSelectRegion"
                            Content="🔲 Chọn vùng"
                            Height="30" Width="120"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnSelectRegion_Click"/>

                            <!-- Nút tạo mẫu -->
                            <Button x:Name="BtnCreateTemplate"
                            Content="📋 Tạo mẫu"
                            Height="30" Width="110"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Click="BtnCreateTemplate_Click"/>

                            <!-- Nút thêm mẫu lỗ định vị (developer mode) -->
                            <Button x:Name="BtnCreateFiducialTemplates"
                                    Content="⭕ Thêm mẫu lỗ"
                                    Height="30" Width="130"
                                    IsEnabled="False"
                                    Visibility="Collapsed"
                                    Margin="0,0,8,0"
                                    Click="BtnCreateFiducialTemplates_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />

                <!-- Nút xem mẫu -->
                <Button x:Name="BtnViewTemplates"
                        Content="🖼 Xem mẫu"
                        Height="30" Width="110"
                        Margin="0,0,8,0"
                        Click="BtnViewTemplates_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />

                <!-- Nút chụp ảnh -->
                <Button x:Name="BtnCapture"
                        Content="📷 Chụp"
                        Height="30" Width="90"
                        IsEnabled="False"
                        Click="BtnCapture_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />

            </WrapPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1" Margin="8">

            <!-- Preview camera -->
            <Border Background="#1E1E1E">
                <Grid>
                    <Image x:Name="CameraImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality" />
                    <TextBlock x:Name="CameraPlaceholder"
                               Text="Camera chưa khởi động"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888888"
                               FontSize="16" />
                    <Canvas x:Name="SelectionCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                            MouseMove="SelectionCanvas_MouseMove"
                            MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp"
                            IsHitTestVisible="False">
                        <Rectangle x:Name="DragRect"
                                   Stroke="Yellow"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 2"
                                   Fill="Transparent"
                                   Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

                    <!-- ===== STATUS BAR ===== -->
                    <Border Grid.Row="2" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusText"
                                           Grid.Column="0"
                                           Text="Sẵn sàng."
                                           VerticalAlignment="Center"
                                           Foreground="#555555"
                                           FontSize="12" />
                                <TextBlock x:Name="FpsText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="#555555"
                                           FontSize="12" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="RobotSerialText"
                                           Text="● Robot Offline"
                                           VerticalAlignment="Top"
                                           Foreground="#E74C3C"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="RobotSerialDetail"
                                           VerticalAlignment="Top"
                                           Foreground="#666666"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"/>
                            </StackPanel>
                            <TextBox Grid.Row="2" x:Name="TxtRobotRxLog"
                                     Margin="0,4,0,0"
                                     Height="54"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="10"
                                     Background="#FAFAFA"
                                     BorderBrush="#DDDDDD"
                                     ToolTip="Nhật ký Serial RX (Serial_DataReceived)"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
    </Grid>
</UserControl>
