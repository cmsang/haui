<Window x:Class="Haui.PCB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Haui.PCB"
        mc:Ignorable="d"
        Title="PCB Segmentation Tool"
        Icon="/Image/ACS.ico"
        xmlns:v="clr-namespace:Haui.PCB.Views"
                
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"  
        
        Height="1080" Width="1930" 
        MinHeight="500" MinWidth="700"
        Loaded="Window_Loaded"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D13438" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A4262C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="7.5*"/>
        </Grid.ColumnDefinitions>

        <!--Tab điều khiển-->
        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="3.5*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="14*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#2E4053">
                <Image Source="/Image/TA logo2.png"
                       Stretch="Uniform" MaxHeight="120" Margin="8"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>
            <Grid Grid.Row="1" Background="#2E4053">
                <Button Height="69"  Background="#2E4053" BorderBrush="#2E4053"
                        x:Name="btnDashboard" Click="btnDashboard_Click" >
                </Button>
                <md:PackIcon Kind="ViewDashboardOutline" Width="35" Height="35" VerticalAlignment="Center"
                             Foreground="White" IsHitTestVisible="False"
                             Margin="30,0,0,0"/>
                <TextBlock Text="Dashboard" FontSize="16" Height="20" Margin="90,0,0,0" Foreground="White"
                           MouseDown="btnDashboard_Click"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>
            
            <Grid Grid.Row="2" Background="#2E4053">
                <Button Height="69"  Background="#2E4053" BorderBrush="#2E4053"
                        x:Name="btnCommandHistory" Click="btnCommandHistory_Click">
                </Button>
                <md:PackIcon Kind="ArrangeSendBackward" Width="35" Height="35" VerticalAlignment="Center"
                             Foreground="White" IsHitTestVisible="False"
                             Margin="30,0,0,0"/>
                <TextBlock Text="Job History" FontSize="16" Height="20" Margin="90,0,0,0" 
                               MouseDown="btnCommandHistory_Click" Foreground="White"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>
           
            <Grid Grid.Row="4" Background="#2E4053">
                <Button Height="69"  Background="#2E4053" BorderBrush="#2E4053"
                        x:Name="btnManualControl" Click="btnManualControl_Click">
                </Button>
                <md:PackIcon Kind="Apps" Width="35" Height="35" VerticalAlignment="Center"
                             Foreground="White" IsHitTestVisible="False"
                             Margin="30,0,0,0"/>
                <TextBlock Text="Manual Control" FontSize="16" Height="20" Foreground="White"
                           Margin="90,0,0,0" MouseDown="btnManualControl_Click"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>
            <Grid Grid.Row="5" Background="#2E4053">
                <Button Height="69"  Background="#2E4053" BorderBrush="#2E4053"
                        x:Name="btnSetting" Click="btnSetting_Click">
                </Button>
                <md:PackIcon Kind="CogSyncOutline" Width="35" Height="35" VerticalAlignment="Center"
                             Foreground="White" IsHitTestVisible="False"
                             Margin="30,0,0,0"/>
                <TextBlock Text="Setting" FontSize="16" Height="20" Foreground="White"
                           Margin="90,0,0,0" MouseDown="btnSetting_Click"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>

            <Grid Grid.Row="3" Background="#2E4053">
                <Button Height="75" x:Name="btnTeaching" Click="btnTeaching_Click"  VerticalAlignment="Top"
                        Background="#2E4053" BorderBrush="#2E4053">
                </Button>
                <md:PackIcon Kind="LinkVariant" Width="35" Height="35" VerticalAlignment="Center"
                             Foreground="White" IsHitTestVisible="False"
                             Margin="30,0,0,0"/>
                <TextBlock Text="Robot Teaching" FontSize="16" Height="20" Margin="90,0,0,0" 
                               MouseDown="btnTeaching_Click" Foreground="White"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>

            <Grid Grid.Row="6" Background="#2E4053">
                <Button Height="69" x:Name="btnExit" Click="btnExit_Click"  VerticalAlignment="Top"
                        Background="#2E4053" BorderBrush="#2E4053" >
                </Button>
                <md:PackIcon Kind="ExitToApp" Width="35" Height="35" VerticalAlignment="Center"
                             Foreground="White" IsHitTestVisible="False"
                             Margin="30,0,0,0"/>
                <TextBlock Text="Exit" FontSize="16" Height="20" Margin="90,0,0,0" 
                               Foreground="White" MouseDown="btnExit_Click"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>

            <Grid Grid.Row="7" Background="#2E4053">
                <Button Height="69" x:Name="btnPass" Click="btnPass_Click" VerticalAlignment="Top"
                        Background="#2E4053" BorderBrush="#2E4053"></Button>
                <TextBlock Text="Pass" FontSize="16" Height="20" Margin="90,0,0,0" 
               Foreground="White" MouseDown="btnPass_Click"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>
            <Grid Grid.Row="8" Background="#2E4053">
                <Button Height="69" x:Name="btnFail" Click="btnFail_Click" VerticalAlignment="Top"
                    Background="#2E4053" BorderBrush="#2E4053"></Button>
                <TextBlock Text="Fail" FontSize="16" Height="20" Margin="90,0,0,0" 
                    Foreground="White" MouseDown="btnFail_Click"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>
            <Grid Grid.Row="9" Background="#2E4053">
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>

            <Grid Grid.Row="10" Background="#2E4053">
                <Image Source="/Image/Logo user.png"
                       Width="60" HorizontalAlignment="Left"/>
                <TextBlock x:Name="lblUser" Text="Trần Tuấn Em" Foreground="White" FontSize="12" Height="15" Margin="60,0,0,0"/>
                <Image Source="/Image/green dot.png"
                       Height="8" Width="8" HorizontalAlignment="Left" Margin="60,23,0,0" />
                <TextBlock  Text="Online" FontSize="8" Height="10" Foreground="White"  Margin="70,25,0,0"/>
                <Rectangle StrokeThickness="1" Width="1" HorizontalAlignment="Right" Fill="Gray"></Rectangle>
            </Grid>

        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="1" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="0*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1">
                            <v:ArcGauge x:Name="AGV_Connect"
                            AngleValue="0"
                            TotalValue= "1"
                            FullValue="1"                                    
                            EmptyValue="0"
                            ColorArc1Value="#90a4ae"
                            ColorArc2Value="#8d6e63"
                            ColorText1Value="DarkBlue"
                            ColorText2Value="#90a4ae"
                            Text1Value="C" 
                            Text2Value="D" 
                            VerticalAlignment="Bottom" 
                            Height="127" Margin="0,-3,0,-15"/>
                        </Grid>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <!--<Rectangle  Height="80" Width="1" Fill="Gray" HorizontalAlignment="Left" Margin="0,20"/>-->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Label x:Name="lbl_LoadCount" Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="40" FontWeight="Bold"/>
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="1">
                                <Rectangle Width="1" Fill="Gray" HorizontalAlignment="Right"/>
                                <Label x:Name="lbl_UnloadCount" Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="40" FontWeight="Bold"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="0">
                                <Label Content="LOAD" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="1">
                                <Rectangle Width="1" Fill="Gray" HorizontalAlignment="Right"/>
                                <Label Content="UNLOAD" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                            </Grid>

                        </Grid>
                        <Grid Grid.Column="2">
                            <v:ArcGauge x:Name="AGV_FullState"
                            AngleValue="{Binding Angle_Empty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TotalValue="{Binding TotalAGV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FullValue="{Binding Full_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EmptyValue="{Binding Empty_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ColorArc1Value="#90a4ae"
                            ColorArc2Value="#8d6e63"
                            ColorText1Value="DarkBlue"
                            ColorText2Value="#90a4ae"                                  
                            Text1Value="F" 
                            Text2Value="E" 
                            VerticalAlignment="Bottom" 
                            Height="127"
                            TitleValue="CONNECT" Margin="0,-3,0,-15"/>

                        </Grid>
                        <Grid Grid.Column="3">
                            <v:ArcGauge x:Name="AGV_RunState"
                            AngleValue="{Binding AngleDisconnect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TotalValue="{Binding TotalAGV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FullValue="{Binding Run_value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EmptyValue="{Binding Stop_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ColorArc1Value="#90a4ae"
                            ColorArc2Value="#8d6e63"
                            ColorText1Value="DarkBlue"
                            ColorText2Value="#90a4ae"
                            Text1Value="R" 
                            Text2Value="S" 
                            VerticalAlignment="Bottom" 
                            Height="127"
                            TitleValue="CONNECT" Margin="0,-3,0,-15"/>

                        </Grid>
                        <Grid Grid.Column="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="0.1*"/>
                                <RowDefinition Height="1*"/>
                                <!--<RowDefinition Height="0.1*"/>-->
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0"  Background="#FFE0EAEA">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="1.5*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Content="5 MIN" 
                                   HorizontalAlignment="Center" VerticalContentAlignment="Center" 
                                   FontSize="9" Width="32" />
                                </Grid>

                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="2"  Background="#FFE0EAEA">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="1.5*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Content="10 MIN" 
                                   HorizontalAlignment="Center" VerticalContentAlignment="Center" 
                                   FontSize="9" Width="38"/>
                                </Grid>

                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="0"  Background="#FFE0EAEA">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="1.5*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Content="15 MIN" 
                                   HorizontalAlignment="Center" VerticalContentAlignment="Center" 
                                   FontSize="9" Width="38"/>
                                </Grid>

                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="2"  Background="#FFE0EAEA">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="1.5*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="000" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Content="20 MIN" 
                                   HorizontalAlignment="Center" VerticalContentAlignment="Center" 
                                   FontSize="9" Width="38"/>
                                </Grid>

                            </Grid>

                        </Grid>
                        <Grid Grid.Column="5">
                            <Rectangle Width="1" Fill="Gray" HorizontalAlignment="Left"/>
                            <v:ArcGauge x:Name="Buffer_FullState"
                            AngleValue="{Binding AngleDisconnect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TotalValue="{Binding TotalAGV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FullValue="{Binding Full_value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EmptyValue="{Binding Empty_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ColorArc1Value="#90a4ae"
                            ColorArc2Value="#8d6e63"
                            ColorText1Value="DarkBlue"
                            ColorText2Value="#90a4ae"
                            Text1Value="F" 
                            Text2Value="E" 
                            VerticalAlignment="Bottom" 
                            Height="127"
                            TitleValue="CONNECT" HorizontalAlignment="Left" Margin="0,-3,0,-15" Width="219" />

                        </Grid>
                        <!--<Grid Grid.Column="6">
                    <v:ArcGauge Width="222" 
                        AngleValue="{Binding AngleDisconnect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TotalValue="{Binding TotalAGV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FullValue="{Binding Full_value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        EmptyValue="{Binding Empty_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ColorArc1Value="#90a4ae"
                        ColorArc2Value="#8d6e63"
                        ColorText1Value="DarkBlue"
                        ColorText2Value="#90a4ae"
                        Text1Value="F" 
                        Text2Value="E" 
                        VerticalAlignment="Bottom" 
                        Height="127"
                        TitleValue="CONNECT" Margin="1,0,-53,-20" />

                </Grid>-->
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <!--<Grid Grid.Column="0">
                <Label Content="System" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
            </Grid>-->
                        <Grid Grid.Column="1">
                            <Label Content="COMMAND" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Label Content="VEHICLE" 
                           HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Grid.Column="3">
                            <Label Content="BUFFER" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <!--<Grid Grid.Column="4">
                    <Label Content="FULL STATE" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                </Grid>-->
                        <!--<Grid Grid.Column="5">
                    <Label Content="FULL STATE" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <Grid Grid.Column="7">
                    <Label Content="FULL STATE" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                </Grid>-->
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid x:Name="Grid_Camera" Background="AliceBlue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ===== TOOLBAR ===== -->
                    <Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="10,6">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Chọn camera -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Camera:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                                <ComboBox x:Name="CameraComboBox"
                              Width="150" Height="30"
                              FontSize="13"
                              SelectionChanged="CameraComboBox_SelectionChanged" />
                            </StackPanel>

                            <!-- Chọn độ phân giải -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Độ phân giải:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                                <ComboBox x:Name="ResolutionComboBox"
                              Width="120" Height="30"
                              FontSize="13" />
                            </StackPanel>

                            <Separator Width="1" Height="28" Background="#CCCCCC" Margin="4,0,12,0" />

                            <!-- Nút Start -->
                            <Button x:Name="BtnStart"
                            Content="▶ Bắt đầu"
                            Height="30" Width="100"
                            Margin="0,0,8,0"
                            Click="BtnStart_Click"/>

                            <!-- Nút Stop -->
                            <Button x:Name="BtnStop"
                            Content="■ Dừng"
                            Height="30" Width="100"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnStop_Click"/>

                            <!-- Nút Test -->
                            <Button x:Name="BtnTest"
                            Content="🔬 Test"
                            Height="30" Width="100"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnTest_Click"/>

                            <!-- Nút Test 2: xem từng bước pipeline -->
                            <Button x:Name="BtnTest2"
                            Content="🧪 Test 2"
                            Height="30" Width="100"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnTest2_Click"/>

                            <!-- Nút chọn vùng nhận diện -->
                            <Button x:Name="BtnSelectRegion"
                            Content="🔲 Chọn vùng"
                            Height="30" Width="120"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnSelectRegion_Click"/>

                            <!-- Nút tạo mẫu -->
                            <Button x:Name="BtnCreateTemplate"
                            Content="📋 Tạo mẫu"
                            Height="30" Width="110"
                            IsEnabled="False"
                            Margin="0,0,8,0"
                            Click="BtnCreateTemplate_Click"/>

                <!-- Nút xem mẫu -->
                <Button x:Name="BtnViewTemplates"
                        Content="🖼 Xem mẫu"
                        Height="30" Width="110"
                        Margin="0,0,8,0"
                        Click="BtnViewTemplates_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />

                <!-- Nút chụp ảnh -->
                <Button x:Name="BtnCapture"
                        Content="📷 Chụp"
                        Height="30" Width="90"
                        IsEnabled="False"
                        Click="BtnCapture_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />

            </WrapPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Preview camera -->
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    Margin="0,0,8,0">
                <Grid>
                    <Image x:Name="CameraImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality" />
                    <TextBlock x:Name="CameraPlaceholder"
                               Text="Camera chưa khởi động"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888888"
                               FontSize="16" />
                    <Canvas x:Name="SelectionCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                            MouseMove="SelectionCanvas_MouseMove"
                            MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp"
                            IsHitTestVisible="False">
                        <Rectangle x:Name="DragRect"
                                   Stroke="Yellow"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 2"
                                   Fill="Transparent"
                                   Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Border>

            <!-- Panel tham số Basler -->
            <Border Grid.Column="1"
                    x:Name="CameraParamsPanel"
                    Width="280"
                    Background="#FAFAFA"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Tham số camera Basler"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Exposure (µs)" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ExposureSlider"
                                Grid.Column="0"
                                Minimum="100"
                                Maximum="200000"
                                TickFrequency="5000"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0" />
                        <TextBox x:Name="ExposureTextBox"
                                 Grid.Column="1"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 FontSize="12" />
                    </Grid>

                    <TextBlock Text="Gain (dB)" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="GainSlider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="24"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0" />
                        <TextBox x:Name="GainTextBox"
                                 Grid.Column="1"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 FontSize="12" />
                    </Grid>

                    <TextBlock Text="Gamma" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="GammaSlider"
                                Grid.Column="0"
                                Minimum="0.4"
                                Maximum="2.0"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0" />
                        <TextBox x:Name="GammaTextBox"
                                 Grid.Column="1"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 FontSize="12" />
                    </Grid>

                    <Button x:Name="BtnApplyParams"
                            Content="Áp dụng"
                            Height="32"
                            Margin="0,0,0,8"
                            Click="BtnApplyParams_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Button x:Name="BtnResetParams"
                            Content="Đặt lại"
                            Height="32"
                            Click="BtnResetParams_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <TextBlock Text="Chỉnh exposure/gain rồi bấm Áp dụng. Đặt lại = tham số khuyến nghị."
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               FontSize="11"
                               Margin="0,10,0,0" />

                    <Separator Margin="0,14,0,12" Background="#DDDDDD" />

                    <TextBlock Text="Pipeline — Canny edges"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Ngưỡng thấp (threshold1)" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="Canny1Slider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="255"
                                TickFrequency="5"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0" />
                        <TextBox x:Name="Canny1TextBox"
                                 Grid.Column="1"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 FontSize="12" />
                    </Grid>

                    <TextBlock Text="Ngưỡng cao (threshold2)" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="Canny2Slider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="255"
                                TickFrequency="5"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0" />
                        <TextBox x:Name="Canny2TextBox"
                                 Grid.Column="1"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 FontSize="12" />
                    </Grid>

                    <Button x:Name="BtnResetCanny"
                            Content="Đặt lại Canny"
                            Height="32"
                            Click="BtnResetCanny_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <TextBlock Text="Áp dụng ngay cho Test, Test 2 và Tạo mẫu. Chạy lại pipeline sau khi chỉnh."
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               FontSize="11"
                               Margin="0,10,0,0" />

                    <Separator Margin="0,14,0,12" Background="#DDDDDD" />

                    <TextBlock Text="4 lỗ tròn định vị"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock Text="4 lỗ giống nhau — mỗi lần lưu thêm một ảnh mẫu; pipeline so khớp tất cả. Thư mục lưu: chỉnh FiducialHoles trong appsettings.json."
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               FontSize="11"
                               Margin="0,0,0,8" />

                    <Button x:Name="BtnCreateFiducialTemplates"
                            Content="⭕ Thêm mẫu lỗ"
                            Height="32"
                            IsEnabled="False"
                            Margin="0,0,0,8"
                            Click="BtnCreateFiducialTemplates_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <TextBlock x:Name="FiducialStatusText"
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               FontSize="11"
                               Margin="0,0,0,0" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

                    <!-- ===== STATUS BAR ===== -->
                    <Border Grid.Row="2" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusText"
                                           Grid.Column="0"
                                           Text="Sẵn sàng."
                                           VerticalAlignment="Center"
                                           Foreground="#555555"
                                           FontSize="12" />
                                <TextBlock x:Name="FpsText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="#555555"
                                           FontSize="12" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="RobotSerialText"
                                           Text="● Robot Offline"
                                           VerticalAlignment="Top"
                                           Foreground="#E74C3C"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="RobotSerialDetail"
                                           VerticalAlignment="Top"
                                           Foreground="#666666"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"/>
                            </StackPanel>
                            <TextBox Grid.Row="2" x:Name="TxtRobotRxLog"
                                     Margin="0,4,0,0"
                                     Height="54"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="10"
                                     Background="#FAFAFA"
                                     BorderBrush="#DDDDDD"
                                     ToolTip="Nhật ký Serial RX (Serial_DataReceived)"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
