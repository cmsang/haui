<Window x:Class="Haui.PCB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Haui.PCB"
        mc:Ignorable="d"
        Title="PCB Segmentation Tool"
        Height="680" Width="1024"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Style nút chính -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút phụ -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút đỏ Stop -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D13438" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A4262C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Chọn camera -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Camera:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                    <ComboBox x:Name="CameraComboBox"
                              Width="150" Height="30"
                              FontSize="13"
                              SelectionChanged="CameraComboBox_SelectionChanged" />
                </StackPanel>

                <!-- Chọn độ phân giải -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Độ phân giải:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                    <ComboBox x:Name="ResolutionComboBox"
                              Width="120" Height="30"
                              FontSize="13" />
                </StackPanel>

                <Separator Width="1" Height="28" Background="#CCCCCC" Margin="4,0,12,0" />

                <!-- Nút Start -->
                <Button x:Name="BtnStart"
                        Content="▶ Bắt đầu"
                        Height="30" Width="100"
                        Margin="0,0,8,0"
                        Click="BtnStart_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <!-- Nút Stop -->
                <Button x:Name="BtnStop"
                        Content="■ Dừng"
                        Height="30" Width="90"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="BtnStop_Click"
                        Style="{StaticResource DangerButtonStyle}" />

                <!-- Nút Test -->
                <Button x:Name="BtnTest"
                        Content="🔬 Test"
                        Height="30" Width="90"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="BtnTest_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />

                <!-- Nút chọn vùng nhận diện -->
                <Button x:Name="BtnSelectRegion"
                        Content="🔲 Chọn vùng"
                        Height="30" Width="110"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="BtnSelectRegion_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />

                <!-- Nút tạo mẫu -->
                <Button x:Name="BtnCreateTemplate"
                        Content="📋 Tạo mẫu"
                        Height="30" Width="100"
                        IsEnabled="False"
                        Click="BtnCreateTemplate_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />

            </WrapPanel>
        </Border>

        <!-- ===== PANEL CAMERA ===== -->
        <Border Grid.Row="1"
                Background="#1E1E1E"
                Margin="8">
            <Grid>
                <Image x:Name="CameraImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="LowQuality" />
                <TextBlock x:Name="CameraPlaceholder"
                           Text="Camera chưa khởi động"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#888888"
                           FontSize="16" />
                <!-- Canvas kéo thả chọn vùng -->
                <Canvas x:Name="SelectionCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                        MouseMove="SelectionCanvas_MouseMove"
                        MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp"
                        IsHitTestVisible="False">
                    <!-- Hình chữ nhật kéo thả (chỉ hiện khi đang kéo) -->
                    <Rectangle x:Name="DragRect"
                               Stroke="Yellow"
                               StrokeThickness="2"
                               StrokeDashArray="4 2"
                               Fill="Transparent"
                               Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="2"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Sẵn sàng."
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12" />
                <TextBlock x:Name="FpsText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
