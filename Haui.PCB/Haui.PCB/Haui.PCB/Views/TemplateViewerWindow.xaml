<Window x:Class="Haui.PCB.Views.TemplateViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thư viện ảnh mẫu"
        Height="680" Width="1100"
        MinHeight="480" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F4FA"/>
            <Setter Property="BorderBrush" Value="#C0CCE0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A3A6B"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="26"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== CONTENT ===== -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: 2 grid -->
                <ColumnDefinition Width="340" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── Cột trái ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Grid 1: Danh sách ảnh mẫu -->
                <Border Grid.Row="0"
                        BorderBrush="#C0CCE0" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" CornerRadius="4,4,0,0">
                            <TextBlock Text="📋 Danh sách ảnh mẫu"
                                       Style="{StaticResource SectionTitleStyle}"/>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  x:Name="TemplatesGrid"
                                  Style="{StaticResource DataGridStyle}"
                                  SelectionChanged="TemplatesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT"
                                                   Binding="{Binding Stt}"
                                                   Width="40"/>
                                <DataGridTextColumn Header="Tên mẫu"
                                                   Binding="{Binding Name}"
                                                   Width="*"/>
                                <DataGridTextColumn Header="Số vùng"
                                                   Binding="{Binding RegionCount}"
                                                   Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Grid 2: Danh sách vùng của mẫu đang chọn -->
                <Border Grid.Row="2"
                        BorderBrush="#C0CCE0" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" CornerRadius="4,4,0,0">
                            <TextBlock Text="🔲 Các vùng được chọn"
                                       Style="{StaticResource SectionTitleStyle}"/>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  x:Name="RegionsGrid"
                                  Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT"
                                                   Binding="{Binding Stt}"
                                                   Width="40"/>
                                <DataGridTextColumn Header="Tên vùng"
                                                   Binding="{Binding Name}"
                                                   Width="*"/>
                                <DataGridTextColumn Header="Vị trí"
                                                   Binding="{Binding Position}"
                                                   Width="90"/>
                                <DataGridTextColumn Header="Kích thước"
                                                   Binding="{Binding Size}"
                                                   Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- ── Cột phải: Xem ảnh mẫu ── -->
            <Border Grid.Column="2"
                    Background="#1E1E1E"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#2A2A2A"
                            CornerRadius="4,4,0,0"
                            Padding="8,5">
                        <TextBlock Text="🖼 Xem ảnh mẫu"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#DDDDDD"/>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="PreviewPlaceholder"
                                   Text="Chọn một ảnh mẫu để xem"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#666666"
                                   FontSize="14"/>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BOTTOM BAR ===== -->
        <Border Grid.Row="1"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12"
                           Text="Sẵn sàng."/>
                <Button Content="✕ Đóng"
                        HorizontalAlignment="Right"
                        Height="30" Width="80"
                        Click="BtnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#D13438"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#A4262C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
