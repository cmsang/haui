<Window x:Class="Haui.PCB.wdTeaching"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Cài đặt Robot — Teach vị trí"
        Height="835" Width="1280"
        MinHeight="600" MinWidth="100"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        WindowStyle="None"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#2E4053"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D566E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JogBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B0BEC5"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Homing trục này (H)"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D35400"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B0BEC5"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="JointRowBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E8ECF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AngleBadge" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="JointLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2E4053" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="RobotIndustrial" Width="32" Height="32" Foreground="White" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Teach vị trí cánh tay Robot" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Cấu hình 5 khớp quay (RRRRR) theo góc xoay" FontSize="12" Foreground="#BDC3C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#1ABC9C" CornerRadius="4" Padding="10,4">
                    <TextBlock Text="RRRRR" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Serial connection -->
        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="COM" VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip="Đọc/ghi từ setting.json"/>
                <ComboBox Grid.Column="1" x:Name="CboComPort" IsEditable="True"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          ToolTip="setting.json → com"/>
                <TextBlock Grid.Column="2" Text="Baud" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3" x:Name="CboBaudRate" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="4" Text="STEPS_PER_DEG" VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip="Đọc/ghi từ setting.json (int)"/>
                <TextBox Grid.Column="5" x:Name="TxtStepsPerDeg" VerticalAlignment="Center" Margin="0,0,12,0"
                         ToolTip="setting.json → stepsPerDeg"/>
                <TextBlock Grid.Column="6" x:Name="TxtSerialState" Text="● Offline"
                           Foreground="#E74C3C" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="8" x:Name="BtnSerialToggle" Content="Kết nối"
                        Style="{StaticResource PrimaryBtn}" Padding="12,6" Margin="0,0,8,0"
                        Click="BtnSerialToggle_Click"/>
                <Button Grid.Column="9" Content="↻" ToolTip="Quét lại cổng COM"
                        Style="{StaticResource SecondaryBtn}" Padding="10,6"
                        Click="BtnRefreshPorts_Click"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Joint control -->
            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Điều khiển khớp (Joint Space)" Style="{StaticResource SectionHeader}"/>

                    <!-- Jog settings -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Bước jog (°)" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CboJogStep" SelectedValuePath="Content"
                                      SelectionChanged="CboJogStep_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Tốc độ Go To (%)" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                            <Slider x:Name="SldSpeed" Minimum="1" Maximum="100" TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SldSpeed_ValueChanged"/>
                            <TextBlock x:Name="TxtSpeed" HorizontalAlignment="Center" FontSize="11" Foreground="#666"/>
                        </StackPanel>
                    </Grid>

                    <!-- Joint sliders -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,2,4,0">
                        <ItemsControl x:Name="JointsPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource JointRowBorder}">
                                        <Grid MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="138"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="62"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource JointLabel}"/>

                                            <Button Grid.Column="1" Style="{StaticResource HomeBtn}"
                                                    Margin="0,0,10,0"
                                                    DataContext="{Binding}"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanOperateRobot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="JointHome_Click">
                                                <md:PackIcon Kind="Home" Width="20" Height="20"
                                                             IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Grid.Column="2" Content="−" Style="{StaticResource JogBtn}"
                                                    Margin="0,0,12,0"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanAdjustJoints, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="JogMinus_Click"/>

                                            <Slider Grid.Column="3" Margin="4,0"
                                                    VerticalAlignment="Center"
                                                    Minimum="{Binding MinAngle}"
                                                    Maximum="{Binding MaxAngle}"
                                                    IsEnabled="{Binding DataContext.CanAdjustJoints, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Value="{Binding Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    PreviewMouseLeftButtonUp="JointSlider_Released"/>

                                            <Button Grid.Column="4" Content="+" Style="{StaticResource JogBtn}"
                                                    Margin="12,0,10,0"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanAdjustJoints, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="JogPlus_Click"/>

                                            <Border Grid.Column="5" Style="{StaticResource AngleBadge}">
                                                <TextBlock Text="{Binding AngleText}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0"
                                ToolTip="Gửi lệnh H+0 — homing firmware tất cả trục"
                                IsEnabled="{Binding CanOperateRobot}"
                                Click="BtnHoming_Click">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Home" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Homing tất cả" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Zero UI" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0"
                                ToolTip="Reset góc hiển thị trên UI về 0°"
                                Click="BtnZeroAll_Click"/>
                        <Button Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0"
                                ToolTip="Mở gripper (gửi lệnh G mở)"
                                IsEnabled="{Binding CanOperateRobot}"
                                Click="BtnOpenGripper_Click">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowExpandHorizontal" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mở gripper" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryBtn}"
                                ToolTip="Đóng gripper (gửi lệnh G đóng)"
                                IsEnabled="{Binding CanOperateRobot}"
                                Click="BtnCloseGripper_Click">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowCollapseHorizontal" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đóng gripper" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Teach points -->
            <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Danh sách vị trí teach" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="PickUp · Wait PickUp · Pick Done · Wait · Wait OK1–4 · Wait NG1–4 · OK1–4 · NG1–4"
                                   FontSize="11" Foreground="#888" Margin="0,-6,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="TeachPointsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionChanged="TeachPointsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" Width="100"/>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="90"/>
                            <DataGridTextColumn Header="J1" Binding="{Binding J1, StringFormat=F1}" Width="75"/>
                            <DataGridTextColumn Header="J2" Binding="{Binding J2, StringFormat=F1}" Width="75"/>
                            <DataGridTextColumn Header="J3" Binding="{Binding J3, StringFormat=F1}" Width="75"/>
                            <DataGridTextColumn Header="J4" Binding="{Binding J4, StringFormat=F1}" Width="75"/>
                            <DataGridTextColumn Header="J5" Binding="{Binding J5, StringFormat=F1}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Teach hint -->
                    <Border Grid.Row="2" Background="#EBF5FB" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#2C3E50">
                            <Run FontWeight="SemiBold">Hướng dẫn teach:</Run>
                            <Run> Chọn vị trí trong bảng → bấm</Run>
                            <Run FontWeight="SemiBold">Go To</Run>
                            <Run>→ điều chỉnh khớp bên trái → bấm </Run>
                            <Run FontWeight="SemiBold">Teach vị trí</Run>
                            <Run> để lưu góc J1–J5. </Run>
                            <Run FontWeight="SemiBold">Wait PickUp</Run>
                            <Run>, </Run>
                            <Run FontWeight="SemiBold">Pick Done</Run>
                            <Run>, </Run>
                            <Run FontWeight="SemiBold">Wait OK1–4</Run>
                            <Run>, </Run>
                            <Run FontWeight="SemiBold">Wait NG1–4</Run>
                            <Run> — teach thủ công. Sau gắp robot về </Run>
                            <Run FontWeight="SemiBold">Pick Done</Run>
                            <Run> rồi mới tới vùng place (tránh va đập).</Run>
                        </TextBlock>
                    </Border>

                    <!-- Actions -->
                    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="Go To" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8"
                                IsEnabled="{Binding CanOperateRobot}"
                                Click="BtnGoTo_Click"/>
                        <Button Content="Teach vị trí" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8"
                                IsEnabled="{Binding CanTeachSelectedPoint}"
                                Click="BtnTeach_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Joint summary -->
        <Border Grid.Row="3" Background="#F5F5F5" CornerRadius="4" Padding="10,6" Margin="0,12,0,0">
            <TextBlock x:Name="TxtJointSummary" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontSize="12" Foreground="#666"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lưu cấu hình" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0"
                        Click="BtnSave_Click"/>
                <Button Content="Đóng" Style="{StaticResource SecondaryBtn}"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
