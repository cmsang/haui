<Window
    x:Class="Haui.GTObjectDetector.Views.TestPipelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra bo mạch"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Ảnh bo mạch đã cắt ── -->
        <Border Grid.Row="0"
                BorderBrush="#CCCCCC" BorderThickness="1"
                Background="#1E1E1E"
                Margin="8,8,8,4">
            <Grid>
                <TextBlock Text="Bo mạch đã cắt"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,6,0,0"
                           FontWeight="SemiBold"
                           Foreground="#AAAAAA" />
                <Image x:Name="ProcessedImage"
                       Margin="0,28,0,4"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="ProcessedPlaceholder"
                           Text="Đang chờ xử lý..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           FontSize="14" />
            </Grid>
        </Border>

        <!-- ── Tiêu đề kết quả so sánh ── -->
        <TextBlock Grid.Row="1"
                   Text="Kết quả so sánh vùng"
                   FontWeight="SemiBold"
                   FontSize="13"
                   Foreground="#333333"
                   Margin="12,6,8,2" />

        <!-- ── 2 grid kết quả ── -->
        <Grid Grid.Row="2" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vùng KHÁC NHAU (< 80%) — bên trái -->
            <Border Grid.Column="0"
                    BorderBrush="#D13438" BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#FFEDED"
                            CornerRadius="4,4,0,0"
                            Padding="8,4">
                        <TextBlock Text="⚠ Vùng khác nhau (&lt; 80%)"
                                   FontWeight="SemiBold"
                                   Foreground="#D13438" />
                    </Border>
                    <DataGrid Grid.Row="1"
                              x:Name="DifferentGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              FontSize="12"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT"
                                               Binding="{Binding Stt}"
                                               Width="40"/>
                            <DataGridTextColumn Header="Tên vùng"
                                               Binding="{Binding Name}"
                                               Width="*" />
                            <DataGridTextColumn Header="Độ tương đồng"
                                               Binding="{Binding SimilarityText}"
                                               Width="110" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#D13438" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Vùng GIỐNG NHAU (>= 80%) — bên phải -->
            <Border Grid.Column="2"
                    BorderBrush="#00B050" BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#E8F5E9"
                            CornerRadius="4,4,0,0"
                            Padding="8,4">
                        <TextBlock Text="✔ Vùng giống nhau (≥ 80%)"
                                   FontWeight="SemiBold"
                                   Foreground="#00752A" />
                    </Border>
                    <DataGrid Grid.Row="1"
                              x:Name="MatchedGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              FontSize="12"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT"
                                               Binding="{Binding Stt}"
                                               Width="40"/>
                            <DataGridTextColumn Header="Tên vùng"
                                               Binding="{Binding Name}"
                                               Width="*" />
                            <DataGridTextColumn Header="Độ tương đồng"
                                               Binding="{Binding SimilarityText}"
                                               Width="110" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#00752A" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Thanh nút phía dưới ── -->
        <Border Grid.Row="3"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnSelectImage"
                        Content="🖼 Chọn ảnh"
                        Width="130" Height="36"
                        Margin="0,0,12,0"
                        Click="BtnSelectImage_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="BtnTest"
                        Content="▶ Test lại"
                        Width="130" Height="36"
                        IsEnabled="False"
                        Click="BtnTest_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Foreground="#666666"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>